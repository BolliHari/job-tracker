{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.0.1",
  "description": "Save jobs from LinkedIn, Indeed, Wellfound, and company career pages to your Job Tracker vault.",
  "permissions": ["storage", "activeTab", "sidePanel", "tabs", "scripting"],
  "host_permissions": [
    "https://job-tracker-server-r4lr.onrender.com/*",
    "https://job-tracker-server-r4lr.onrender.com/*",
    "https://job-tracker-u64j.vercel.app/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.indeed.com/*",
    "https://indeed.com/*",
    "https://wellfound.com/*",
    "https://www.wellfound.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Job Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*"
      ],
      "js": ["content/shared.js", "content/linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.indeed.com/*",
        "https://indeed.com/*",
        "https://*.indeed.com/*"
      ],
      "js": ["content/shared.js", "content/indeed.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wellfound.com/*",
        "https://www.wellfound.com/*"
      ],
      "js": ["content/shared.js", "content/wellfound.js"],
      "run_at": "document_idle"
    }
  ]
}
